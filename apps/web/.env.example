# Habilita el flujo con wallet y proveedores de prueba.
NEXT_PUBLIC_ALPHA_MODE=testnet

# Operaciones compartidas de Testnet. Solo servidor. Aplica npm run db:migrate antes de habilitar.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stellar
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_LOT_PASSPORT_CONTRACT_ID=CDNM2H5XU3IR5YVE6TJJE36RPFIKWVQ2WEPNRSLAMW2JPAURETVCZ7BO
# Lote de referencia con contraparte y atestaciones ya registradas en LotPassport.
NEXT_PUBLIC_TESTNET_IMPORTER_LOT_ID=2026-JAE-014-SOLO01
NEXT_PUBLIC_PREMIUM_SPLITTER_CONTRACT_ID=

# Activos del escrow (Testnet). Verificar contra faucet.circle.com antes de usar.
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_EURC_ISSUER=GB3Q6QDZYTHWT7E5PVS3W7FUT5GVAFC5KSZFFLPU25GO7VTC3NM2ZTVO

# --- Solo servidor: NUNCA con prefijo NEXT_PUBLIC_ ---
# Trustless Work (Testnet). La versión se deduce de la URL:
#   v1: https://dev.api.trustlesswork.com  (claves del dApp de Testnet)
#   v2: https://beta.api.trustlesswork.com (claves del dApp v2)
# Todas las wallets de rol necesitan trustline del activo (USDC/EURC).
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=
# ACTA (credenciales). Clave en https://dapp.acta.build > API Keys.
ACTA_API_URL=https://sandbox-api.acta.build
ACTA_API_KEY=
# Dirección pública de la wallet que creó ACTA_API_KEY. Solo valida la cuenta antes de pedir firmas.
NEXT_PUBLIC_ACTA_ISSUER_ADDRESS=
# Whisp (FAO). Clave en tu cuenta de https://whisp.openforis.org
WHISP_API_URL=https://whisp.openforis.org
WHISP_API_KEY=

# Cuentas de servicio de Alpha Pass en el escrow (generar con Keypair.random()).
# La aprobadora firma en el servidor solo si LotPassport confirma el hito.
ALPHA_APPROVER_SECRET=
ALPHA_APPROVER_PUBLIC=
ALPHA_ADMIN_SECRET=
ALPHA_ADMIN_PUBLIC=
ALPHA_DISPUTE_RESOLVER_SECRET=
ALPHA_DISPUTE_RESOLVER_PUBLIC=
ALPHA_PLATFORM_SECRET=
ALPHA_PLATFORM_PUBLIC=

# --- Demo guiada de una sola wallet (/demo). Solo servidor y solo Testnet. ---
# Cuentas de la casa que firman los roles que no elige quien prueba.
# npm run demo:setup las crea, las fondea con Friendbot y USDC de prueba y autoriza
# al verificador en LotPassport. Copia los valores a Vercel sin el prefijo NEXT_PUBLIC_.
ALPHA_DEMO_COOP_SECRET=
ALPHA_DEMO_COOP_PUBLIC=
ALPHA_DEMO_BUYER_SECRET=
ALPHA_DEMO_BUYER_PUBLIC=
ALPHA_DEMO_VERIFIER_SECRET=
ALPHA_DEMO_VERIFIER_PUBLIC=
# Emisora ACTA: la wallet de Testnet con la que se creó ACTA_API_KEY (ACTA solo acepta
# a esa wallet como emisora). npm run demo:setup registra su did:stellar y guarda la
# identidad en ALPHA_ACTA_ISSUER_IDENTITY (JSON entre comillas simples).
ALPHA_ACTA_ISSUER_SECRET=
ALPHA_ACTA_ISSUER_IDENTITY=
